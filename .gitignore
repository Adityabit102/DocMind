# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Environment
.env

# Runtime data (keep dir structure via .gitkeep)
data/uploads/*
!data/uploads/.gitkeep
data/faiss_index/*
!data/faiss_index/.gitkeep
data/metadata.json
data/jobs.json
data/users.json
logs/*
!logs/.gitkeep
evaluation/results/*
!evaluation/results/.gitkeep
evaluation/testsets/*
!evaluation/testsets/.gitkeep

# Frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# AI assistant config
.claude/

# ── Model-building extension (finetune/ vlm_module/ eval_harness/) ──
# Keep the saved LoRA adapter + reports as demonstrable artifacts, but skip
# transient training checkpoints and degradation-preview scratch.
finetune/adapters/*/checkpoints/
eval_harness/_degrade_preview/
# LoRA weight binaries: HF Spaces' git remote rejects plain-git binary files
# (requires LFS/Xet). Config, tokenizer, loss curves, and metrics ARE kept as
# evidence the run happened; only the weight tensors themselves are excluded.
# Reproduce with: python -m finetune.train_lora --run-name <name> (see
# MODEL_BUILDING.md quickstart) — config/seed are recorded in run_config.json.
finetune/adapters/**/adapter_model.safetensors
models/

# DocMind reverse proxy — automatic HTTPS via Let's Encrypt.
# The domain comes from the DOMAIN env var (set in .env). Point a DNS A record
# for that domain at the server's IP. One origin: API paths go to the backend,
# everything else to the frontend, so the browser never makes a cross-origin
# request (no CORS to configure).

{$DOMAIN} {
	encode zstd gzip

	# Backend (FastAPI)
	@api path /api/* /metrics /docs* /redoc* /openapi.json
	handle @api {
		reverse_proxy backend:8000
	}

	# Frontend (Next.js)
	handle {
		reverse_proxy frontend:3000
	}
}

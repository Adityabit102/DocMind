# ════════════════════════════════════════════════════════════════════
#  DocMind — environment configuration
#  Copy to `.env` and edit. Defaults below are LOCAL-FIRST: the app runs
#  with NO API keys (HuggingFace embeddings + Ollama). Add keys to upgrade.
# ════════════════════════════════════════════════════════════════════

# ── LLM ─────────────────────────────────────────────────────────────
LLM_PROVIDER=ollama                 # openai | anthropic | ollama | groq
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Groq: OpenAI-compatible, free tier, very fast. Generation only — embeddings
# stay local (Groq has no embeddings endpoint). Get a key at console.groq.com.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3                    # groq: llama-3.3-70b-versatile · openai: gpt-4o-mini · ollama: llama3
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# ── Embeddings ──────────────────────────────────────────────────────
EMBEDDING_PROVIDER=huggingface      # openai | huggingface
EMBEDDING_MODEL=all-MiniLM-L6-v2    # text-embedding-3-small | all-MiniLM-L6-v2 | BAAI/bge-large-en-v1.5

# ── Retrieval ───────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
CHUNK_STRATEGY=recursive            # recursive | semantic | parent
RETRIEVAL_K=20
RERANKER_TOP_K=5
RETRIEVAL_MODE=hybrid               # similarity | mmr | hybrid
ENSEMBLE_DENSE_WEIGHT=0.6
ENSEMBLE_BM25_WEIGHT=0.4
# Reranker backend. Hosted options fall back to the local cross-encoder when the
# matching key is unset, so the zero-key path always works.
RERANKER_PROVIDER=cross_encoder     # cross_encoder | cohere | voyage
COHERE_API_KEY=
VOYAGE_API_KEY=
ENABLE_QUERY_EXPANSION=true
ENABLE_HYDE=false
ENABLE_RERANKING=true
ENABLE_CONTEXT_COMPRESSION=false
ENABLE_CRAG=true
ENABLE_SELF_RAG=false

# ── Cache ───────────────────────────────────────────────────────────
CACHE_BACKEND=memory                # memory | redis
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=86400
CACHE_SCORE_THRESHOLD=0.95

# ── Observability ───────────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=docmind
LOG_LEVEL=INFO
ENABLE_QUERY_LOGGING=true

# ── Security ────────────────────────────────────────────────────────
API_KEY_AUTH_ENABLED=false
API_KEY=your-secret-key
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
API_RATE_LIMIT=60
MAX_UPLOAD_SIZE_MB=50
MAX_QUERY_CHARS=2000
ENABLE_PII_REDACTION=false
# Heuristic prompt-injection / jailbreak screen on inbound queries.
ENABLE_PROMPT_GUARD=false
# User accounts + per-user document/conversation isolation. Off = single-user.
ENABLE_AUTH=false
AUTH_SECRET=change-me-in-production
AUTH_TOKEN_TTL_HOURS=168
USERS_FILE=data/users.json

# ── Storage ─────────────────────────────────────────────────────────
UPLOAD_DIR=data/uploads
FAISS_INDEX_DIR=data/faiss_index
EVAL_RESULTS_DIR=evaluation/results
EVAL_TESTSET_DIR=evaluation/testsets
METADATA_FILE=data/metadata.json
LOG_FILE=logs/app.log

# ── Evaluation ──────────────────────────────────────────────────────
RAGAS_TEST_SIZE=50
DRIFT_ALERT_THRESHOLD=0.15
# Periodic auto-evaluation (background scheduler). Interval is in hours (168 = weekly).
ENABLE_SCHEDULED_EVAL=false
SCHEDULED_EVAL_INTERVAL_HOURS=168

# ── Ingestion: vision image captioning ──────────────────────────────
# Caption figures/diagrams embedded in PDFs with a vision model (gpt-4o / llava).
# No-op unless a vision-capable model is configured. Disabled by default.
ENABLE_IMAGE_CAPTIONING=false
VISION_MODEL=llava

# ── Deployment (docker-compose.prod.yml + Caddy) ────────────────────
DOMAIN=docmind.example.com

# ── Free persistence on ephemeral hosts (HF Spaces): sync data/ to a
#    private HuggingFace dataset. Leave blank to disable.
HF_TOKEN=
HF_DATASET_REPO=
